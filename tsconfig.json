{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@lynxfita/core": ["packages/core/src/index.ts"],
      "@lynxfita/wasi-runtime": ["packages/wasi-runtime/src/index.ts"],
      "@lynxfita/codegen": ["packages/codegen/src/index.ts"],
      "@lynxfita/builder": ["packages/builder/src/index.ts"],
      "@lynxfita/updater": ["packages/updater/src/index.ts"],
      "@lynxfita/cli": ["packages/cli/src/index.ts"],
      "@lynxfita/example-weather-showcase": ["examples/weather-showcase/src/index.ts"],
      "@lynxfita/explorer": ["examples/explorer/src/index.ts"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
